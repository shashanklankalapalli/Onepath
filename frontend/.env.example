# OnePath Frontend Environment Configuration
#
# When VITE_API_BASE_URL is not set or left commented out:
# OnePath dynamically routes API requests to:
# - http://localhost:8080/api when viewed on your laptop (localhost/127.0.0.1)
# - http://<laptop-ip>:8080/api when viewed on your phone over Wi-Fi / LAN
#
# If you want to explicitly override the backend address, uncomment and adjust:
# VITE_API_BASE_URL=http://10.212.53.153:8080/api
# Or use the Vite dev proxy:
# VITE_API_BASE_URL=/api

VITE_BACKEND_PORT=8080
